NODE_ENV=development
PORT=3020

# PostgreSQL — use your local user or Docker credentials
# Docker: postgresql://postgres:postgres@localhost:5432/platform_manager
# macOS local: postgresql://<your-username>@localhost:5432/platform_manager
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform_manager

ANTHROPIC_API_KEY=

PAYMENT_API_URL=http://localhost:3004
PAYMENT_API_KEY=

# Absolute path to the platforms directory
PLATFORMS_DIR=/absolute/path/to/Fintech/platforms

# Admin connection to the shared postgres server — used to CREATE DATABASE for each new platform
# Must point to a superuser with CREATE DATABASE privileges; database must be "postgres"
# Local (macOS):  postgresql://<your-username>@localhost:5432/postgres
# Docker:         postgresql://postgres:postgres@postgres:5432/postgres
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

CADDY_ADMIN_URL=http://localhost:2019
