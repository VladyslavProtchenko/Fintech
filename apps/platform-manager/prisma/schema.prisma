generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Platform {
  id          String         @id @default(uuid())
  slug        String         @unique
  domain      String         @unique
  displayName String
  status      PlatformStatus @default(CREATING)
  siteUrl     String?
  errorMsg    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum PlatformStatus {
  CREATING
  BUILDING
  RUNNING
  STOPPED
  FAILED
}
