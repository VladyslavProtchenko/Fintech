generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PhotoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DUPLICATE
  FLAGGED
}

model Photo {
  id            String           @id @default(uuid())
  originalName  String
  mimeType      String
  size          Int
  sha256        String           @unique
  originalPath  String
  status        PhotoStatus      @default(PENDING)
  jobId         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  ocrResults    OcrResult[]
  mergedResult  MergedOcrResult?
  fraudAnalysis FraudAnalysis?
}

model FraudAnalysis {
  id               String   @id @default(uuid())
  photoId          String   @unique
  score            Float
  verdict          String   // CLEAN | SUSPICIOUS | LIKELY_FORGED
  flags            String[]
  metadataResult   Json?
  elaResult        Json?
  geminiResult     Json?
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())
  photo            Photo    @relation(fields: [photoId], references: [id])
}

model MergedOcrResult {
  id              String   @id @default(uuid())
  photoId         String   @unique
  mergedText      String
  confidenceScore Float
  mergeStrategy   String   // 'direct' | 'gemini-arbitrated'
  selectedSource  String?  // 'paddle' | 'surya' (when direct)
  createdAt       DateTime @default(now())
  photo           Photo    @relation(fields: [photoId], references: [id])
}

model OcrResult {
  id        String   @id @default(uuid())
  photoId   String
  source    String   // 'paddle' | 'surya'
  rawText   String?
  data      Json
  createdAt DateTime @default(now())
  photo     Photo    @relation(fields: [photoId], references: [id])
}
