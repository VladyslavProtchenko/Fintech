generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  paymentClientId String?  @unique
  walletId        String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
